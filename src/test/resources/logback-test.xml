<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%date{MM-dd HH:mm:ss ZZZZ} %level [%thread] - %message%n%xException{10}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Avoid printing SQL parameters, connection details, or credentials in CI logs. -->
    <logger name="io.ebean.SQL" level="OFF"/>
    <logger name="io.ebean.TXN" level="OFF"/>
    <logger name="io.ebean.cache" level="WARN"/>

</configuration>
