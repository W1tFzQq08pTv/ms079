# Copy this file to .env and set a strong password before initializing a new database.
COMPOSE_PROJECT_NAME=ms079
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ms079
MYSQL_IMAGE=mysql:5.7
MYSQL_CONTAINER_NAME=ms079-mysql
MYSQL_PORT=3306
MYSQL_DATA_DIR=./docker/mysql/data
MYSQL_HEALTH_INIT_SQL=./docker/mysql/init/00-healthcheck.sql
MYSQL_INIT_SQL=./db/ms079.sql

SERVER_IMAGE=ms079-server:local
SERVER_CONTAINER_NAME=ms079-server
SERVER_BUILD_TARGET=runtime
LOGIN_PORT=9595
CHANNEL_PORT_RANGE=7575-7578
CASHSHOP_PORT=8600
WZ_DATA_DIR=./wz
SCRIPT_DIR=./脚本
SERVER_CONFIG_FILE=./服务端配置.ini
SERVER_LOG_DIR=./logs
